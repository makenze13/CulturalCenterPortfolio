<Window x:Class="CulturalCenterWpf.Views.ChangeUserDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CulturalCenterWpf.Views"
        mc:Ignorable="d"
        Title="Изменение данных пользователя"
        Width="460"
        Height="390"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize" Icon="/Resource/CulturalCenterPNG.png">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0">

            <TextBlock Text="Данные пользователя"
                       Style="{StaticResource SectionTitleStyle}"/>

            <TextBlock Text="Изменение логина и пароля пользователя"
                       Style="{StaticResource SectionDescriptionStyle}"/>

        </StackPanel>


        <StackPanel Grid.Row="1"
                    Margin="0,28,0,20">


            <TextBlock Text="Логин"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="LoginTextBox"
                     Style="{StaticResource TextBoxStyle}"
                     Margin="0,0,0,18"/>


            <TextBlock Text="Новый пароль"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6"/>

            <Grid>

                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource InputPasswordBoxStyle}"
                             Padding="14,0,48,0"/>

                <TextBox x:Name="PasswordTextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         Padding="14,0,48,0"
                         Visibility="Collapsed"/>

                <Button x:Name="ShowPasswordButton"
                        Width="36"
                        Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0"
                        Content="👁"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Style="{StaticResource ShowPasswordButtonStyle}"
                        Click="ShowPasswordButton_Click"/>

            </Grid>

        </StackPanel>


        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Отмена"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    x:Name="CancelButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>

            <Button Content="Сохранить"
                    Width="110"
                    Height="40"
                    Style="{StaticResource ActionButtonStyle}"
                    x:Name="SaveButton"
                    Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
