<Window x:Class="CulturalCenterWpf.Views.Cashier.MainCashierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CulturalCenterWpf.Views.Cashier"
        mc:Ignorable="d"
        Title="Успех — Панель кассира"
        Width="1280"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0D0D0F" Loaded="Window_Loaded" Icon="/Resource/CulturalCenterPNG.png">

    <Grid Background="{StaticResource BackgroundBrush}">

        <!--Разметка панели-->
        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="235"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!--Боковая панель-->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="18,24">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <StackPanel Grid.Row="0"
                            Margin="8,0,8,35">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="◆"
                                   FontSize="19"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="УСПЕХ"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <TextBlock Text="Система управления"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="28,4,0,0"/>

                </StackPanel>



                <StackPanel Grid.Row="1">


                    <TextBlock Text="РАБОТА"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="12,0,0,8"/>


                    <Button x:Name="EventsButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="EventsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⌂"
                                       FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Мероприятия"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <TextBlock Text="ФИЛЬТРЫ" 
                               FontSize="10" 
                               Foreground="{StaticResource SecondaryTextBrush}" 
                               Margin="14,10,0,10"/>

                    <ComboBox x:Name="EventTypeComboBox" 
                              Height="38" Margin="0,0,0,10" 
                              Style="{StaticResource ComboBoxStyle}" 
                              DisplayMemberPath="TypeEvent"
                              ToolTip="Тип мероприятия"/>

                    <DatePicker x:Name="EventDatePicker" 
                                Height="38" 
                                Margin="0,0,0,10" 
                                Style="{StaticResource DarkDatePickerStyle}"/>

                    <TextBlock Text="СОРТИРОВКА" 
                               FontSize="10" 
                               Foreground="{StaticResource SecondaryTextBrush}" 
                               Margin="14,18,0,10"/>

                    <ComboBox x:Name="SortComboBox" 
                              Height="38" 
                              Style="{StaticResource ComboBoxStyle}"
                              Margin="0 10 0 10">

                        <ComboBoxItem Content="По дате"/>
                        <ComboBoxItem Content="По названию"/>
                        <ComboBoxItem Content="По цене"/>

                    </ComboBox>

                    <ComboBox x:Name="SortDirectionComboBox"
                              Height="38"
                              Margin="0,0,0,15"
                              Style="{StaticResource ComboBoxStyle}">

                        <ComboBoxItem Content="По возрастанию"
                                      Tag="asc"/>

                        <ComboBoxItem Content="По убыванию"
                                      Tag="desc"/>

                    </ComboBox>

                    <CheckBox x:Name="isRelevantCheckBox"
                              Content="Только актуальные мероприятия"
                              IsChecked="True"
                              FontSize="11"
                              Margin="0,5,0,15"
                              Foreground="{StaticResource PrimaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="Применить"
                                Width="100"
                                Height="38"
                                Margin="0,0,8,0"
                                Style="{StaticResource ActionButtonStyle}"
                                x:Name="ApplyFiltersButton"
                                Click="ApplyFiltersButton_Click"/>

                        <Button Content="Сбросить"
                                Width="90"
                                Height="38"
                                Style="{StaticResource SecondaryButtonStyle}"
                                x:Name="ResetFiltersButton"
                                Click="ResetFiltersButton_Click"/>

                    </StackPanel>

                </StackPanel>
                
                <StackPanel Grid.Row="2">

                    <Button Style="{StaticResource NavigationButtonStyle}"
                                x:Name="ExitButton"
                                Click="ExitButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="↪"
                                           FontSize="18"
                                           Width="30"/>

                            <TextBlock Text="Выйти"/>

                        </StackPanel>

                    </Button>

                </StackPanel>
            </Grid>
        </Border>


        <!--Основная панель-->
        <Grid Grid.Column="1"
              Margin="42,32,42,32">

            <!--Разметка строк основной панели-->
            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!--Верхняя строка основной панели-->
            <Grid Grid.Row="0">

                <!-- Надпись-->
                <StackPanel>

                    <TextBlock Text="Панель управления"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Text="Управление мероприятиями и сотрудниками"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,6,0,0"/>

                </StackPanel>

                <!--Личный кабинет сотрудника-->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Border Width="36"
                            Height="36"
                            Background="{StaticResource CardBrush}"
                            CornerRadius="18">

                        <TextBlock Text="М"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="10,0,0,0"
                                VerticalAlignment="Center">

                        <Button x:Name="ProfileButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ProfileButtonStyle}"
                                Click="ProfileButton_Click">

                            <StackPanel>
                                <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           x:Name="currentUserNameTextBlock"/>

                                <TextBlock Text="Кассир"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>

                        </Button>

                    </StackPanel>

                </StackPanel>

            </Grid>


            <!--Линия разделяющая строки-->
            <Border Grid.Row="1"
                    Height="1"
                    Background="{StaticResource BorderBrush}"
                    Margin="0,25,0,25"/>


            <!--ПАНЕЛЬ ПРОСМОТРА МЕРОПРИЯТИЙ-->
            <Border Grid.Row="2" 
                    x:Name="eventsBorder"
                    Visibility="Visible"
                    Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Margin="0,28,0,0" 
                    Padding="24">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>

                            <TextBlock Text="Все мероприятия" 
                                       FontSize="18" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryTextBrush}"/>

                            <TextBlock Text="Выберите мероприятие для продажи билета" 
                                       FontSize="12" 
                                       Foreground="{StaticResource SecondaryTextBrush}" 
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                        <TextBox x:Name="SearchTextBox" 
                                 Width="300" 
                                 Height="40" 
                                 HorizontalAlignment="Right" 
                                 VerticalAlignment="Center" 
                                 Style="{StaticResource TextBoxStyle}" 
                                 ToolTip="Поиск мероприятия"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="30,30,20,25">

                        <ItemsControl x:Name="EventsItemsControl">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Margin="0,0,10,8"
                                            Padding="20,14"
                                            Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Cursor="Hand"
                                            x:Name="СhooseEventBorder"
                                            MouseLeftButtonUp="ChooseEventBorder_MouseLeftButtonUp">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>


                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="{Binding EventDate, StringFormat={}{0:dd.MM.yyyy}}"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"/>

                                                <TextBlock Text="{Binding EventDate, StringFormat={}{0:dddd}, ConverterCulture=ru}"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>

                                            </StackPanel>


                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="15,0,15,0">

                                                <TextBlock Text="{Binding EventName}"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding TypeEvent}"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0"/>

                                            </StackPanel>


                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="{Binding EventDate, StringFormat={}{0:HH:mm}}"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontSize="14"/>

                                                <TextBlock Text="Начало"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>

                                            </StackPanel>


                                            <StackPanel Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">

                                                <TextBlock Text="{Binding AvgTicketPrice, StringFormat={}{0:N0} ₽}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"/>

                                                <TextBlock Text="Стоимость"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"
                                                           HorizontalAlignment="Right"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>
            </Border>

            <!--ПАНЕЛЬ ПРОСМОТРА ЛИЧНОГО КАБИНЕТА-->
            <Border Grid.Row="2"
                    x:Name="profileBorder"
                    Visibility="Hidden"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,28,0,0"
                    Padding="24">

                <StackPanel>

                    <TextBlock Text="Личный кабинет"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Text="Информация о вашей учетной записи"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,25"/>

                    <Border Background="{StaticResource BorderBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Менеджер"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,5,0,0"/>

                            <TextBlock x:Name="nameUserTextBlock"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Margin="0, 0, 0, 20"/>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock  Grid.Row="0"
                                            Text="Логин"
                                            Foreground="{StaticResource SecondaryTextBrush}"/>

                                <TextBlock Grid.Row="1"
                                           x:Name="loginUserTextBlock"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="14"
                                           Margin="0,5,0,15"/>

                            </Grid>

                            <Button Content="Изменить данные"
                                    HorizontalAlignment="Left"
                                    Margin="0,15,0,0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    x:Name="ChangeDataButton"
                                    Click="ChangeDataButton_Click"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

            <!--ПАНЕЛЬ ПРОСМОТРА МЕРОПРИЯТИЯ ПОДРОБНЕЕ-->
            <Border Grid.Row="2" 
                    x:Name="eventDetailsBorder" 
                    Visibility="Collapsed" 
                    Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Margin="0,28,0,0" 
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--ПОДРОБНАЯ ИНФОРМАЦИЯ О МЕРОПРИЯТИИ-->

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding EventName}"
                                    FontSize="20" 
                                    FontWeight="SemiBold" 
                                    Foreground="{StaticResource PrimaryTextBrush}"/>

                            <TextBlock Text="{Binding TypeEvent}"
                                        FontSize="12" 
                                        Foreground="{StaticResource SecondaryTextBrush}" 
                                        Margin="0,5,0,0"/>

                            <TextBlock Text="Полное описание" 
                                        FontSize="12" 
                                        FontWeight="SemiBold" 
                                        Foreground="{StaticResource SecondaryTextBrush}" 
                                        Margin="0,22,0,6"/>

                            <TextBlock Text="{Binding EventDescription}"
                                        FontSize="13"
                                        HorizontalAlignment="Left"                                           
                                        Foreground="{StaticResource PrimaryTextBrush}" 
                                        MaxWidth="650"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="20,5,0,0">
                            <TextBlock Text="ДАТА" 
                                        FontSize="10" 
                                        Foreground="{StaticResource SecondaryTextBrush}"/>

                            <TextBlock Text="{Binding EventDate, StringFormat={}{0:dd.MM.yyyy}}"
                                        FontSize="14" 
                                        Foreground="{StaticResource PrimaryTextBrush}" 
                                        Margin="0,5,0,0"/>

                            <TextBlock Text="ВРЕМЯ" 
                                        FontSize="10" 
                                        Foreground="{StaticResource SecondaryTextBrush}" 
                                        Margin="0,18,0,0"/>

                            <TextBlock Text="{Binding EventDate, StringFormat={}{0:HH:mm}}"
                                        FontSize="14" 
                                        Foreground="{StaticResource PrimaryTextBrush}" 
                                        Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="20,5,0,0">

                            <TextBlock Text="ЦЕНА" 
                                        FontSize="10" 
                                        Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding AvgTicketPrice}"
                                        FontSize="18" 
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentBrush}" 
                                        Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,30,0,0" 
                            Background="{StaticResource BackgroundBrush}" 
                            BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="25">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" HorizontalAlignment="Center">

                                <TextBlock Text="ВЫБОР МЕСТА" 
                                           FontSize="12" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource PrimaryTextBrush}" 
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Выберите свободное место в зале" 
                                           FontSize="11" 
                                           Foreground="{StaticResource SecondaryTextBrush}" 
                                           Margin="0,4,0,0" 
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Row="1" 
                                      
                                    Height="auto" 
                                    HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Top" 
                                    Background="{StaticResource CardBrush}" 
                                    BorderBrush="{StaticResource BorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                    <TextBlock Text="СХЕМА ЗАЛА" 
                                               FontSize="18" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource SecondaryTextBrush}" 
                                               HorizontalAlignment="Center"
                                               Margin="0 15 0 15"/>

                                    <Border x:Name="hallBorder"
                                            Background="#1E1E1E"
                                            CornerRadius="10"
                                            Padding="15"
                                            Height="auto">

                                        <Grid>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>


                                            <Border Grid.Row="0"
                                                    Width="300"
                                                    Height="40"
                                                    Background="Gray"
                                                    CornerRadius="5"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,20">

                                                <TextBlock Text="СЦЕНА"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Bold"
                                                           Foreground="White"/>

                                            </Border>


                                            <Grid Grid.Row="1">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>


                                                <StackPanel Grid.Column="0">

                                                    <TextBlock Text="C1"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,8"/>

                                                    <ItemsControl x:Name="SectorC1" Margin="30, 0, 30, 0">

                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>

                                                                <UniformGrid Rows="15"
                                                                            Columns="10"/>

                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>

                                                                <local:SeatControl/>

                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>

                                                    </ItemsControl>

                                                </StackPanel>


                                                <StackPanel Grid.Column="1">

                                                    <TextBlock Text="C2"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,8"/>

                                                    <ItemsControl x:Name="SectorC2" Margin="30, 0, 30, 0">

                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>

                                                                <UniformGrid Rows="15"
                                                                            Columns="10"/>

                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>

                                                                <local:SeatControl/>

                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>

                                                    </ItemsControl>

                                                </StackPanel>


                                                <StackPanel Grid.Column="2" Margin="30, 0, 30, 0">

                                                    <TextBlock Text="C3"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,8"/>

                                                    <ItemsControl x:Name="SectorC3">

                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>

                                                                <UniformGrid Rows="15"
                                                                            Columns="10"/>

                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>

                                                                <local:SeatControl/>

                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>

                                                    </ItemsControl>

                                                </StackPanel>

                                            </Grid>

                                        </Grid>

                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
