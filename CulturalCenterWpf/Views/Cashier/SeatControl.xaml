<UserControl x:Class="CulturalCenterWpf.Views.Cashier.SeatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CulturalCenterWpf.Views.Cashier"
             Width="32"
             Height="32" Loaded="UserControl_Loaded">

    <Button x:Name="SeatButton"
            Click="SeatButton_Click"
            Margin="2"
            FontSize="9"
            FontWeight="Bold"
            BorderThickness="1" DataContextChanged="SeatButton_DataContextChanged">

        <TextBlock>
            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0}-{1}">
                    <Binding Path="Row"/>
                    <Binding Path="Number"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <Button.Style>
            <Style TargetType="Button">

                <Setter Property="Background" Value="LightGray"/>
                <Setter Property="Foreground" Value="Black"/>

            </Style>
        </Button.Style>

    </Button>
</UserControl>
