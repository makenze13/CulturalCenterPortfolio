<Window x:Class="CulturalCenterWpf.Views.Cashier.SoldTicketCashierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CulturalCenterWpf.Views.Cashier"
        mc:Ignorable="d"
        Title="Информация о билете"
        Width="520"
        Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" Icon="/Resource/CulturalCenterPNG.png">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="БИЛЕТ ПРОДАН"
                       Style="{StaticResource SectionTitleStyle}"/>

            <TextBlock Text="Информация о приобретённом билете"
                       Style="{StaticResource SectionDescriptionStyle}"/>

        </StackPanel>

        <!-- Информация о билете -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Мероприятие -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="МЕРОПРИЯТИЕ"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"/>

                    <TextBlock x:Name="EventNameTextBlock"
                               Text="{Binding SeatEventDTO.EventName}"
                               Margin="0,7,0,0"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextWrapping="Wrap"/>

                </StackPanel>

                <!-- Дата и время -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="ДАТА"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock x:Name="EventDateTextBlock"
                                   Text="{Binding SeatEventDTO.EventDate, StringFormat={}{0:dd.MM.yyyy}}"
                                   Margin="0,7,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <TextBlock Text="ВРЕМЯ"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock x:Name="EventTimeTextBlock"
                                   Text="{Binding SeatEventDTO.EventDate, StringFormat={}{0:HH:mm}}"
                                   Margin="0,7,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                    </StackPanel>

                </Grid>

                <!-- Место -->
                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="СЕКТОР"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock x:Name="SectorTextBlock"
                                   Text="{Binding Sector}"
                                   Margin="0,7,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <TextBlock Text="РЯД"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock x:Name="RowTextBlock"
                                   Text="{Binding Row}" 
                                   Margin="0,7,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="МЕСТО"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock x:Name="SeatTextBlock"
                                   Text="{Binding Number}" 
                                   Margin="0,7,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                    </StackPanel>

                </Grid>

                <!-- Стоимость -->
                <Border Grid.Row="6"
                        Background="{StaticResource InputBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="16">

                    <Grid>

                        <TextBlock Text="К ОПЛАТЕ"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock x:Name="PriceTextBlock"
                                   Text="{Binding Price, StringFormat={}{0:F2}}" 
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>

                    </Grid>

                </Border>

            </Grid>

        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="ПЕЧАТАТЬ БИЛЕТ"
                    Style="{StaticResource ActionButtonStyle}"
                    x:Name="PrintButton"
                    Click="PrintButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
