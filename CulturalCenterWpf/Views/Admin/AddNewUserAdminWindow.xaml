<Window x:Class="CulturalCenterWpf.Views.Admin.AddNewUserAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CulturalCenterWpf.Views.Admin"
        mc:Ignorable="d"
        Title="Добавление пользователя" 
        Width="500" 
        Height="600" 
        WindowStartupLocation="CenterScreen" 
        Background="{StaticResource BackgroundBrush}" 
        ResizeMode="NoResize" Icon="/Resource/CulturalCenterPNG.png">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Добавление пользователя" Style="{StaticResource SectionTitleStyle}"/>
            <TextBlock Text="Введите данные для учётной записи" Style="{StaticResource SectionDescriptionStyle}"/>
        </StackPanel>


        <StackPanel Grid.Row="1" Margin="0,28,0,20">
            <TextBlock Text="Логин" Foreground="{StaticResource SecondaryTextBrush}" 
                       FontSize="12" 
                       Margin="0,0,0,6"/>

            <TextBox x:Name="LoginTextBox" 
                     Style="{StaticResource TextBoxStyle}" 
                     Margin="0,0,0,18"/>
            
            <TextBlock Text="Пароль" 
                       Foreground="{StaticResource SecondaryTextBrush}" 
                       FontSize="12" 
                       Margin="0,0,0,6"/>

            <TextBox x:Name="PasswordTextBox" 
                         Style="{StaticResource TextBoxStyle}"
                         Margin="0,0,0,18"/>

            <TextBlock Text="Роль" 
                       Foreground="{StaticResource SecondaryTextBrush}" 
                       FontSize="12"
                       Margin="0,0,0,6"/>

            <ComboBox x:Name="RoleComboBox" Style="{StaticResource ComboBoxStyle}" Margin="0,0,0,18">
                <ComboBoxItem Content="Менеджер"/>
                <ComboBoxItem Content="Кассир"/>
                <ComboBoxItem Content="Администратор"/>
            </ComboBox>

            <TextBlock Text="Сотрудник" Foreground="#CCCCCC" Margin="0,0,0,6"/>
            <TextBox x:Name="EmployeeTextBox" 
                     Style="{StaticResource TextBoxStyle}" 
                     Margin="0,0,0,18"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            
            <Button Content="Удалить"
                    Width="90"
                    Height="40"
                    Margin="0,0,10,0"
                    x:Name="DeleteButton"
                    Visibility="Collapsed"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="DeleteButton_Click"/>

            <Button Content="Сброс пароля"
                    Width="120"
                    Height="40"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"
                    Style="{StaticResource DangerButtonStyle}"
                    x:Name="ResetPasswordButton"
                    Click="ResetPasswordButton_Click"/>
            
            <Button Content="Отмена"
                    Width="80"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    x:Name="CancelButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>

            <Button Content="Добавить"
                    Width="95"
                    Height="40"
                    Visibility="Collapsed"
                    Style="{StaticResource ActionButtonStyle}"
                    x:Name="AddButton"
                    Click="AddButton_Click"/>

            <Button Content="Сохранить"
                    Width="95"
                    Height="40"
                    Visibility="Collapsed"
                    Style="{StaticResource ActionButtonStyle}"
                    x:Name="SaveButton"
                    Click="SaveButton_Click"/>
            
        </StackPanel>
    </Grid>
</Window>