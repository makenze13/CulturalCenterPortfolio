<Window x:Class="CulturalCenterWpf.Views.Admin.MainAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CulturalCenterWpf.Views.Admin"
        mc:Ignorable="d"
        Title="Успех — Панель администратора"
        Width="1280"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0F"
        WindowState="Maximized" Icon="/Resource/CulturalCenterPNG.png">

    <Grid Background="{StaticResource BackgroundBrush}">

        <!--Разметка панели-->
        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="235"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!--Боковая панель-->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="18,24">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <StackPanel Grid.Row="0"
                            Margin="8,0,8,35">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="◆"
                                   FontSize="19"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="УСПЕХ"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <TextBlock Text="Система управления"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="28,4,0,0"/>

                </StackPanel>



                <StackPanel Grid.Row="1">


                    <TextBlock Text="РАБОТА"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="12,0,0,8"/>


                    <Button x:Name="HomeButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="HomeButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⌂"
                                       FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Главная"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button x:Name="UsersButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="UsersButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◆"
                                       FontSize="12"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Пользователи"
                                       VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                    <Button x:Name="LogsActionsButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="LogsActionsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="○"
                                       FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Логи действий"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button x:Name="LogsErrorsButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="LogsErrorsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="♙"
                                       FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Логи ошибок"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                    <Button x:Name="SettingsButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="SettingsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="*"
                                       FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Настройки"
                                       VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                </StackPanel>



                <StackPanel Grid.Row="2">

                    <Button Style="{StaticResource NavigationButtonStyle}"
                            x:Name="ExitButton"
                            Click="ExitButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="↪"
                                       FontSize="18"
                                       Width="30"/>

                            <TextBlock Text="Выйти"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>


        <!--Основная панель-->
        <Grid Grid.Column="1"
              Margin="42,32,42,32">

            <!--Разметка строк основной панели-->
            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!--Верхняя строка основной панели-->
            <Grid Grid.Row="0">

                <!-- Надпись-->
                <StackPanel>

                    <TextBlock Text="Панель управления"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Text="Администрирование системы"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,6,0,0"/>

                </StackPanel>

                <!--Личный кабинет сотрудника-->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Border Width="36"
                            Height="36"
                            Background="{StaticResource CardBrush}"
                            CornerRadius="18">

                        <TextBlock Text="М"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="10,0,0,0"
                                VerticalAlignment="Center">

                        <Button x:Name="ProfileButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ProfileButtonStyle}"
                                Click="ProfileButton_Click">

                            <StackPanel>
                                
                                <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           x:Name="currentUserNameTextBlock"/>

                                <TextBlock Text="Администратор"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"/>
                                
                            </StackPanel>

                        </Button>

                    </StackPanel>

                </StackPanel>

            </Grid>


            <!--Линия разделяющая строки-->
            <Border Grid.Row="1"
                    Height="1"
                    Background="{StaticResource BorderBrush}"
                    Margin="0,25,0,25"/>

            
            <!--ПАНЕЛЬ ПРОСМОТРА ПОЛЬЗОВАТЕЛЕЙ-->
            <Border Grid.Row="2"
                    x:Name="usersBorder"
                    Visibility="Hidden"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,28,0,0"
                    Padding="24">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0">

                        <StackPanel>

                            <TextBlock Text="Пользователи"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>

                        </StackPanel>

                        <Button Content="Добавить пользователя"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ActionButtonStyle}"
                                x:Name="AddUserButton"
                                Click="AddUserButton_Click"/>

                    </Grid>


                    <DataGrid Grid.Row="1"
                              MinRowHeight="40"
                              x:Name="UsersDataGrid"
                              Margin="0,20,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="{StaticResource CardBrush}"
                              Foreground="{StaticResource PrimaryTextBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              RowBackground="{StaticResource CardBrush}"
                              AlternatingRowBackground="{StaticResource InputBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              VerticalGridLinesBrush="{StaticResource BorderBrush}"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="UsersDataGrid_MouseDoubleClick">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"                               
                                                Binding="{Binding IdUser}"
                                                Width="Auto"/>

                            <DataGridTextColumn Header="Логин"
                                                Binding="{Binding Login}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Роль в системе"
                                                Binding="{Binding Role}"
                                                Width="Auto"
                                                MinWidth="100"/>

                            <DataGridTextColumn Header="Id сотрудника"
                                                Binding="{Binding IdEmployee}"
                                                Width="120"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!--ПАНЕЛЬ ПРОСМОТРА ЖУРНАЛА ДЕЙСТВИЙ-->
            <Border Grid.Row="2"
                    x:Name="actionLogsBorder"
                    Visibility="Hidden"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,28,0,0"
                    Padding="24">

                <DataGrid Grid.Row="1"
                          MinRowHeight="40"
                          x:Name="LogsActionDataGrid"
                          Margin="0,20,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="{StaticResource CardBrush}"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          RowBackground="{StaticResource CardBrush}"
                          AlternatingRowBackground="{StaticResource InputBrush}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          VerticalGridLinesBrush="{StaticResource BorderBrush}"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID записи"
                                            Binding="{Binding IdRecordLogAction}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="ID пользователя"
                                            Binding="{Binding IdUser}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="Действие"
                                            Binding="{Binding Action}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="Объект"
                                            Binding="{Binding Object}"
                                            Width="*"
                                            MinWidth="120"/>

                        <DataGridTextColumn Header="Дата и время"
                                            Binding="{Binding ActionDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                            Width="160"/>

                        <DataGridTextColumn Header="Система"
                                            Binding="{Binding ActionSystem}"
                                            Width="180"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>
            
            <!--ПАНЕЛЬ ПРОСМОТРА ЖУРНАЛА ОШИБОК-->
            <Border Grid.Row="2"
                    x:Name="errorLogsBorder"
                    Visibility="Hidden"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,28,0,0"
                    Padding="24">

                <DataGrid Grid.Row="1"
                          MinRowHeight="40"
                          x:Name="LogsErrorDataGrid"
                          Margin="0,20,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="{StaticResource CardBrush}"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          RowBackground="{StaticResource CardBrush}"
                          AlternatingRowBackground="{StaticResource InputBrush}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          VerticalGridLinesBrush="{StaticResource BorderBrush}"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID записи"
                                            Binding="{Binding IdRecordLogError}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="ID пользователя"
                                            Binding="{Binding IdUser}"
                                            Width="Auto"/>

                        <DataGridTextColumn Header="Описание ошибки"
                                            Binding="{Binding ErrorDescription}"
                                            Width="*"
                                            MinWidth="200"/>

                        <DataGridTextColumn Header="Дата и время"
                                            Binding="{Binding ErrorDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                            Width="160"/>

                        <DataGridTextColumn Header="Система"
                                            Binding="{Binding ErrorSystem}"
                                            Width="180"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>
            
            <!--ПАНЕЛЬ ПРОСМОТРА НАСТРОЕК-->
            <Border Grid.Row="2"
                    x:Name="settingsBorder"
                    Visibility="Collapsed"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,28,0,0"
                    Padding="24">

                <StackPanel>
                    <TextBlock Text="Адрес API"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="ApiAddressTextBox"
                             Style="{StaticResource TextBoxStyle}"
                             Margin="0,0,0,18"/>

                    <TextBlock Text="Root логин"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            FontSize="12"
                            Margin="0,0,0,6"/>

                    <TextBox x:Name="RootLoginTextBox"
                             Style="{StaticResource TextBoxStyle}"
                             Margin="0,0,0,18"/>

                    <TextBlock Text="Root пароль"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,6"/>

                    <PasswordBox x:Name="RootPasswordBox"
                                 Style="{StaticResource InputPasswordBoxStyle}"
                                 Margin="0,0,0,24"/>

                    <Button Content="Сохранить"
                            x:Name="SaveButton"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Left"
                            Width="130"
                            Height="38"
                            Click="SaveButton_Click"/>
                </StackPanel>

            </Border>

            <!--ПАНЕЛЬ ПРОСМОТРА ЛИЧНОГО КАБИНЕТА-->
            <Border Grid.Row="2"
                    x:Name="profileBorder"
                    Visibility="Hidden"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,28,0,0"
                    Padding="24">

                <StackPanel>

                    <TextBlock Text="Личный кабинет"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Text="Информация о вашей учетной записи"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,25"/>

                    <Border Background="{StaticResource BorderBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Менеджер"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,5,0,0"/>

                            <TextBlock x:Name="nameUserTextBlock"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Margin="0, 0, 0, 20"/>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock  Grid.Row="0"
                                            Text="Логин"
                                            Foreground="{StaticResource SecondaryTextBrush}"/>

                                <TextBlock Grid.Row="1"
                                           x:Name="loginUserTextBlock"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="14"
                                           Margin="0,5,0,15"/>

                            </Grid>

                            <Button Content="Изменить данные"
                                    HorizontalAlignment="Left"
                                    Margin="0,15,0,0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    x:Name="ChangeDataButton"
                                    Click="ChangeDataButton_Click"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>
