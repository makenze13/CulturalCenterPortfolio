<Window x:Class="CulturalCenterWpf.Views.CheckUserPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CulturalCenterWpf.Views"
        mc:Ignorable="d"
        Title="Подтвердите пароль" Height="170" Width="250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D0D0F" Icon="/Resource/CulturalCenterPNG.png">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0"
                   Text="Пароль"
                   FontSize="18"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Margin="17,10,0, 0" Grid.ColumnSpan="2"/>

        <TextBox Grid.Row="1"
                 x:Name="PasswordTextBox"
                 Style="{StaticResource InputTextBoxStyle}"
                 Margin="0,5,0, 0"
                 Width="200"
                 Height="30" Grid.ColumnSpan="2"/>

        <Button Grid.Row="2"
                Content="Подтвердить"
                Style="{StaticResource ActionButtonStyle}"
                x:Name="ConfirmPasswordButton"
                Height="30"
                Width="150"
                Margin="0,15,0,0"
                Padding="0"
                FontSize="16"
                Click="ConfirmPasswordButton_Click" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
