<Window x:Class="CulturalCenterWpf.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CulturalCenterWpf"
        mc:Ignorable="d"
        Title="Успех — Авторизация"
        Width="700"
        Height="650"
        MinWidth="600"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0F"
        ResizeMode="NoResize" Icon="/Resource/CulturalCenterPNG.png">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid Width="420"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,36">

                <TextBlock Text="◆"
                           FontSize="28"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="УСПЕХ"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"/>

            </StackPanel>


            <Border Grid.Row="1"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="42">

                <StackPanel>

                    
                    <TextBlock Text="Добро пожаловать"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>


                    <TextBlock Text="Войдите в систему управления"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,32"/>


                    <TextBlock Text="Логин"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="LoginTextBox"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,20"/>


                    <TextBlock Text="Пароль"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,28">

                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource InputPasswordBoxStyle}"
                                     Padding="14,0,48,0"/>

                        <TextBox x:Name="PasswordTextBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Padding="14,0,48,0"
                                 Visibility="Collapsed"/>

                        <Button x:Name="ShowPasswordButton"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Style="{StaticResource ShowPasswordButtonStyle}"
                                Cursor="Hand"
                                Click="ShowPasswordButton_Click">

                            <TextBlock Text="👁"
                                    FontSize="17"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                        </Button>

                    </Grid>


                    <Button Content="ВОЙТИ В СИСТЕМУ"
                            Style="{StaticResource LoginButtonStyle}"
                            x:Name="LoginButton"
                            Click="LoginButton_Click"/>

                </StackPanel>

            </Border>


            <TextBlock Grid.Row="2"
                       Text="Культурный центр «Успех»"
                       FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,24,0,0"/>

        </Grid>

    </Grid>
</Window>
