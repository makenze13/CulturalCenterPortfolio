<Window x:Class="CulturalCenterWpf.Views.Manager.MainManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CulturalCenterWpf.Views.Manager"
        mc:Ignorable="d"
        Title="Успех — Панель менеджера"
        Width="1280"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0F"
        WindowState="Maximized" Icon="/Resource/CulturalCenterPNG.png">

    <Grid Background="{StaticResource BackgroundBrush}">

        <!--Разметка панели-->
        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="235"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!--Боковая панель-->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="18,24">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <StackPanel Grid.Row="0"
                            Margin="8,0,8,35">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="◆"
                                   FontSize="19"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="УСПЕХ"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <TextBlock Text="Система управления"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="28,4,0,0"/>

                </StackPanel>



                <StackPanel Grid.Row="1">


                    <TextBlock Text="РАБОТА"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="12,0,0,8"/>


                    <Button x:Name="HomeButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="HomeButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="⌂"
                                       FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Главная"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button x:Name="EventsButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="EventsButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="◆"
                                       FontSize="12"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Мероприятия"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button x:Name="OrganizersButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="OrganizersButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="○"
                                       FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Организаторы"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button x:Name="EmployeesButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="EmployeesButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="♙"
                                       FontSize="18"
                                       Width="30"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="Сотрудники"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </StackPanel>



                <StackPanel Grid.Row="2">

                    <Button Style="{StaticResource NavigationButtonStyle}"
                            x:Name="ExitButton"
                            Click="ExitButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="↪"
                                       FontSize="18"
                                       Width="30"/>

                            <TextBlock Text="Выйти"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>


        <!--Основная панель-->
        <Grid Grid.Column="1"
              Margin="42,32,42,32">

            <!--Разметка строк основной панели-->
            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <Grid Grid.Row="0">

                <!--Верхняя строка с надписью-->
                <StackPanel>

                    <TextBlock Text="Панель управления"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Text="Управление мероприятиями и сотрудниками"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,6,0,0"/>

                </StackPanel>

                <!--Личный кабинет сотрудника-->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Border Width="36"
                            Height="36"
                            Background="{StaticResource CardBrush}"
                            CornerRadius="18">

                        <TextBlock Text="М"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Margin="10,0,0,0"
                                VerticalAlignment="Center">

                        <Button x:Name="ProfileButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ProfileButtonStyle}"
                                Click="ProfileButton_Click">

                            <StackPanel>
                                <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           x:Name="currentUserNameTextBlock"/>

                                <TextBlock Text="Менеджер"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>

                        </Button>

                    </StackPanel>

                </StackPanel>

            </Grid>


            <!--Линия разделяющая строки-->
            <Border Grid.Row="1"
                    Height="1"
                    Background="{StaticResource BorderBrush}"
                    Margin="0,25,0,25"/>
            

            <!--ПАНЕЛЬ ПРОСМОТРА МЕРОПРИЯТИЙ-->
            <Border Grid.Row="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,28,0,0"
                    Padding="24"
                    x:Name="eventBorder"
                    Visibility="Hidden">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0">

                        <StackPanel>

                            <TextBlock Text="Мероприятия"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>

                        </StackPanel>


                        <Button Content="Добавить мероприятие"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ActionButtonStyle}"
                                x:Name="AddEventButton"
                                Click="AddEventButton_Click"/>

                    </Grid>

                    <DataGrid Grid.Row="1"
                              MinRowHeight="40"
                              x:Name="EventsDataGrid"
                              Margin="0,20,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="{StaticResource CardBrush}"
                              Foreground="{StaticResource PrimaryTextBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              RowBackground="{StaticResource CardBrush}"
                              AlternatingRowBackground="{StaticResource InputBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              VerticalGridLinesBrush="{StaticResource BorderBrush}"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="EventsDataGrid_MouseDoubleClick">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"                               
                                                Binding="{Binding IdEvent}"
                                                Width="Auto"/>

                            <DataGridTextColumn Header="Название"
                                                Binding="{Binding EventName}"
                                                Width="Auto"/>

                            <DataGridTextColumn Header="Описание"
                                                Binding="{Binding EventDescription}"
                                                Width="*"
                                                MinWidth="100"/>

                            <DataGridTextColumn Header="Дата"
                                                Binding="{Binding EventDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Цена"            
                                                Binding="{Binding AvgTicketPrice}"
                                                Width="Auto"/>
                            
                            <DataGridTextColumn Header="Наименование организатора"
                                                Binding="{Binding OrganizerName}"
                                                Width="Auto"/>

                            <DataGridTextColumn Header="Тип мероприятия"
                                                Binding="{Binding TypeEvent}"
                                                Width="Auto"/>
                            
                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>
            
            <!--ПАНЕЛЬ ПРОСМОТРА ОРГАНИЗАТОРОВ-->
            <Border Grid.Row="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,28,0,0"
                    Padding="24"
                    x:Name="organizerBorder"
                    Visibility="Hidden">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0">

                        <StackPanel>

                            <TextBlock Text="Организаторы"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>

                        </StackPanel>


                        <Button Content="Добавить организатора"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ActionButtonStyle}"
                                x:Name="AddOrganizerButton"
                                Click="AddOrganizerButton_Click"/>

                    </Grid>

                    <DataGrid Grid.Row="1"
                              MinRowHeight="40"
                              x:Name="OrganizersDataGrid"
                              Margin="0,20,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="{StaticResource CardBrush}"
                              Foreground="{StaticResource PrimaryTextBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              RowBackground="{StaticResource CardBrush}"
                              AlternatingRowBackground="{StaticResource InputBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              VerticalGridLinesBrush="{StaticResource BorderBrush}"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="OrganizersDataGrid_MouseDoubleClick">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"                               
                            Binding="{Binding IdOrganizer}"
                            Width="Auto"/>

                            <DataGridTextColumn Header="Название"
                            Binding="{Binding OrganizerName}"
                            Width="Auto"/>

                            <DataGridTextColumn Header="Номер телефона"
                            Binding="{Binding OrganizerNumberPhone}"
                            Width="Auto"/>

                            <DataGridTextColumn Header="Электронная почта"
                            Binding="{Binding OrganizerEmail}"
                            Width="Auto"/>

                            <DataGridTextColumn Header="Описание"            
                            Binding="{Binding OrganizerDescription}"
                            Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!--ПАНЕЛЬ ПРОСМОТРА СОТРУДНИКОВ-->
            <Border Grid.Row="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,28,0,0"
                    Padding="24"
                    x:Name="employeeBorder"
                    Visibility="Hidden">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>



                    <Grid Grid.Row="0">

                        <StackPanel>

                            <TextBlock Text="Сотрудники"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>

                        </StackPanel>


                        <Button Content="Добавить сотрудника"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ActionButtonStyle}"
                                x:Name="AddEmployeeButton"
                                Click="AddEmployeeButton_Click"/>

                    </Grid>

                    <DataGrid Grid.Row="1"
                              MinRowHeight="40"
                              x:Name="EmployeesDataGrid"
                              Margin="0,20,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="{StaticResource CardBrush}"
                              Foreground="{StaticResource PrimaryTextBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              RowBackground="{StaticResource CardBrush}"
                              AlternatingRowBackground="{StaticResource InputBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              VerticalGridLinesBrush="{StaticResource BorderBrush}"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="EmployeesDataGrid_MouseDoubleClick">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"                               
                                                Binding="{Binding IdEmployee}"
                                                Width="Auto"/>

                            <DataGridTemplateColumn Header="ФИО" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1} {2}">
                                                    <Binding Path="LastName"/>
                                                    <Binding Path="FirstName"/>
                                                    <Binding Path="MiddleName"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Номер телефона"
                                                Binding="{Binding NumberPhone}"
                                                Width="Auto"/>

                            <DataGridTextColumn Header="Дата рождения"
                                                Binding="{Binding DateBirth}"
                                                Width="Auto"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!--ПАНЕЛЬ ПРОСМОТРА ЛИЧНОГО КАБИНЕТА-->
            <Border Grid.Row="2"
                    x:Name="profileBorder"
                    Visibility="Hidden"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,28,0,0"
                    Padding="24">

                <StackPanel>

                    <TextBlock Text="Личный кабинет"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <TextBlock Text="Информация о вашей учетной записи"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,25"/>

                    <Border Background="{StaticResource BorderBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Менеджер"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,5,0,0"/>
                            
                            <TextBlock x:Name="nameUserTextBlock"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Margin="0, 0, 0, 20"/>

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock  Grid.Row="0"
                                            Text="Логин"
                                            Foreground="{StaticResource SecondaryTextBrush}"/>

                                <TextBlock Grid.Row="1"
                                           x:Name="loginUserTextBlock"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="14"
                                           Margin="0,5,0,15"/>

                            </Grid>

                            <Button Content="Изменить данные"
                                    HorizontalAlignment="Left"
                                    Margin="0,15,0,0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    x:Name="ChangeDataButton"
                                    Click="ChangeDataButton_Click"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>
