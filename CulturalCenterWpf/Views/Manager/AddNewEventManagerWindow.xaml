<Window x:Class="CulturalCenterWpf.Views.Manager.AddNewEventManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CulturalCenterWpf.Views.Manager"
        mc:Ignorable="d"
        Title="Добавление мероприятия"
        Width="620"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize" Icon="/Resource/CulturalCenterPNG.png">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0">

            <TextBlock Text="Добавление мероприятия"
                       Style="{StaticResource SectionTitleStyle}"/>

            <TextBlock Text="Введите информацию о мероприятии"
                       Style="{StaticResource SectionDescriptionStyle}"/>

        </StackPanel>


        <ScrollViewer Grid.Row="1"
                      Margin="0,28,0,20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <TextBlock Text="Название мероприятия"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,16,6"/>

                <TextBox x:Name="NameEventTextBox"
                         Style="{StaticResource TextBoxStyle}"
                         Margin="0,0,16,16"/>


                <TextBlock Text="Тип мероприятия"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,16,6"/>

                <Grid Margin="0,0,16,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,16,16">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="TypeComboBox"
                                      Grid.Column="0"
                                      Style="{StaticResource ComboBoxStyle}"
                                      DisplayMemberPath="TypeEvent"/>

                            <Button Grid.Column="1"
                                    Content="+"
                                    Width="45"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Добавить тип"
                                    x:Name="ShowAddTypeButton"
                                    Click="ShowAddTypeButton_Click"/>

                            <Button Grid.Column="2"
                                    Content="-"
                                    Width="45"
                                    FontSize="14"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource DangerButtonStyle}"
                                    ToolTip="Удалить выбранный тип"
                                    x:Name="DeleteTypeButton"
                                    Click="DeleteTypeButton_Click"/>
                        </Grid>

                        <Grid x:Name="AddTypePanel"
                              Visibility="Collapsed"
                              Margin="0,10,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="NewTypeTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource TextBoxStyle}"
                                     Margin="0,0,8,0"/>

                            <Button Grid.Column="1"
                                    Content="✓"
                                    Width="45"
                                    Style="{StaticResource ActionButtonStyle}"
                                    ToolTip="Сохранить тип"
                                    x:Name="AddTypeButton"
                                    Click="AddTypeButton_Click"/>
                            
                            <Button Grid.Column="2"
                                    Content="✕"
                                    Width="40"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Отмена"
                                    x:Name="HideButton"
                                    Click="HideButton_Click"/>
                        </Grid>

                    </StackPanel>

                </Grid>


                <TextBlock Text="Организатор"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,16,6"/>

                <ComboBox x:Name="OrganizerComboBox"
                          Style="{StaticResource ComboBoxStyle}"
                          Margin="0,0,16,16"
                          DisplayMemberPath="OrganizerName"/>


                <TextBlock Text="Дата начала"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,16,6"/>

                <DatePicker x:Name="EventDatePicker"
                            Style="{StaticResource DarkDatePickerStyle}"
                            Margin="0,0,16,16"/>


                <TextBlock Text="Время начала"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,16,6"/>

                <ComboBox x:Name="EventTimeComboBox"
                          Style="{StaticResource ComboBoxStyle}"
                          Margin="0, 0, 16, 8">
                    
                    <ComboBoxItem>09:00</ComboBoxItem>
                    <ComboBoxItem>09:30</ComboBoxItem>
                    <ComboBoxItem>10:00</ComboBoxItem>
                    <ComboBoxItem>10:30</ComboBoxItem>
                    <ComboBoxItem>11:00</ComboBoxItem>
                    <ComboBoxItem>11:30</ComboBoxItem>
                    <ComboBoxItem>12:00</ComboBoxItem>
                    <ComboBoxItem>12:30</ComboBoxItem>
                    <ComboBoxItem>13:00</ComboBoxItem>
                    <ComboBoxItem>13:30</ComboBoxItem>
                    <ComboBoxItem>14:00</ComboBoxItem>
                    <ComboBoxItem>14:30</ComboBoxItem>
                    <ComboBoxItem>15:00</ComboBoxItem>
                    <ComboBoxItem>15:30</ComboBoxItem>
                    <ComboBoxItem>16:00</ComboBoxItem>
                    <ComboBoxItem>16:30</ComboBoxItem>
                    <ComboBoxItem>17:00</ComboBoxItem>
                    <ComboBoxItem>17:30</ComboBoxItem>
                    <ComboBoxItem>18:00</ComboBoxItem>
                    <ComboBoxItem>18:30</ComboBoxItem>
                    <ComboBoxItem>19:00</ComboBoxItem>
                    <ComboBoxItem>19:30</ComboBoxItem>
                    <ComboBoxItem>20:00</ComboBoxItem>
                </ComboBox>


                <TextBlock Text="Цена билета"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,16,6"/>

                <TextBox x:Name="PriceTextBox"
                         Style="{StaticResource TextBoxStyle}"
                         Margin="0,0,16,16"/>


                <TextBlock Text="Описание"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,16,6"/>

                <TextBox x:Name="DescriptionTextBox"
                         Style="{StaticResource TextBoxStyle}"
                         Height="100"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Padding="12,10"/>

            </StackPanel>

        </ScrollViewer>


        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,16,0">

            <Button Content="Удалить"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    x:Name="DeleteButton"
                    Visibility="Collapsed"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="DeleteButton_Click"/>
            
            <Button Content="Отмена"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    x:Name="CancelButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>

            <Button Content="Добавить"
                    Width="110"
                    Height="40"
                    Visibility="Collapsed"
                    Style="{StaticResource ActionButtonStyle}"
                    x:Name="AddButton"
                    Click="AddButton_Click"/>

            <Button Content="Сохранить"
                    Width="110"
                    Height="40"
                    Visibility="Collapsed"
                    Style="{StaticResource ActionButtonStyle}"
                    x:Name="SaveButton"
                    Click="SaveButton_Click"/>
            
        </StackPanel>

    </Grid>

</Window>
