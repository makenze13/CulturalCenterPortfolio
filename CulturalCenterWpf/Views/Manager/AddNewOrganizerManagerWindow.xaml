<Window x:Class="CulturalCenterWpf.Views.Manager.AddNewOrganizerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CulturalCenterWpf.Views.Manager"
        mc:Ignorable="d"
         Title="Добавление организатора"
        Width="480"
        Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize" Icon="/Resource/CulturalCenterPNG.png">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0">

            <TextBlock Text="Добавление организатора"
                       Style="{StaticResource SectionTitleStyle}"/>

            <TextBlock Text="Введите информацию об организаторе"
                       Style="{StaticResource SectionDescriptionStyle}"/>

        </StackPanel>


        <StackPanel Grid.Row="1"
                    Margin="0,28,0,20">


            <TextBlock Text="Название организатора"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="NameTextBox"
                     Style="{StaticResource TextBoxStyle}"
                     Margin="0,0,0,18"/>


            <TextBlock Text="Телефон"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="PhoneTextBox"
                     Style="{StaticResource TextBoxStyle}"
                     Margin="0,0,0,18"/>


            <TextBlock Text="Email"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="EmailTextBox"
                     Style="{StaticResource TextBoxStyle}"
                     Margin="0,0,0,18"/>


            <TextBlock Text="Описание"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="DescriptionTextBox"
                     Style="{StaticResource TextBoxStyle}"
                     Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Padding="12,10"/>

        </StackPanel>


        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Удалить"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    x:Name="DeleteButton"
                    Visibility="Collapsed"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="DeleteButton_Click"/>

            <Button Content="Отмена"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    x:Name="CancelButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>

            <Button Content="Добавить"
                    Width="110"
                    Height="40"
                    Visibility="Collapsed"
                    Style="{StaticResource ActionButtonStyle}"
                    x:Name="AddButton"
                    Click="AddButton_Click"/>

            <Button Content="Сохранить"
                    Width="110"
                    Height="40"
                    Visibility="Collapsed"
                    Style="{StaticResource ActionButtonStyle}"
                    x:Name="SaveButton"
                    Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
