<Window x:Class="CulturalCenterWpf.Views.Manager.AddNewEmployeeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CulturalCenterWpf.Views.Manager"
        mc:Ignorable="d"
        Title="Добавление сотрудника"
        Width="520"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize" Icon="/Resource/CulturalCenterPNG.png">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0">

            <TextBlock Text="Добавление сотрудника"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"/>

            <TextBlock Text="Заполните данные нового сотрудника"
                       FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <ScrollViewer Grid.Row="1"
                      Margin="0,25,0,20"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock Text="Фамилия"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="LastNameTextBox"
                         Style="{StaticResource TextBoxStyle}"
                         Margin="0,0,0,18"/>


                <TextBlock Text="Имя"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="FirstNameTextBox"
                         Style="{StaticResource TextBoxStyle}"
                         Margin="0,0,0,18"/>
                

                <TextBlock Text="Отчество"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="MiddleNameTextBox"
                         Style="{StaticResource TextBoxStyle}"
                         Margin="0,0,0,18"/>

                <TextBlock Text="Телефон"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="PhoneTextBox"
                         Style="{StaticResource TextBoxStyle}"
                         Margin="0,0,0,18"/>

                <TextBlock Text="Дата рождения"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,16,6"/>

                <DatePicker x:Name="DateBirthDatePicker"
                            Style="{StaticResource DarkDatePickerStyle}"
                            Margin="0,0,16,16"/>

                <CheckBox x:Name="CreateUserCheckBox"
                          Content="Создать пользователя?"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          FontSize="13"
                          Margin="0,0,0,12"
                          Checked="CreateUserCheckBox_Checked"
                          Unchecked="CreateUserCheckBox_Unchecked"
                          Visibility="Collapsed"/>

                
                <StackPanel x:Name="RolePanel"
                            Visibility="Collapsed">

                    <TextBlock Text="Должность"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="RoleComboBox"
                              Style="{StaticResource ComboBoxStyle}">

                        <ComboBoxItem>Менеджер</ComboBoxItem>
                        <ComboBoxItem>Кассир</ComboBoxItem>
                        <ComboBoxItem>Администратор</ComboBoxItem>

                    </ComboBox>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Удалить"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    x:Name="DeleteButton"
                    Visibility="Collapsed"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="DeleteButton_Click"/>

            <Button Content="Отмена"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    x:Name="CancelButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>

            <Button Content="Добавить"
                    Width="110"
                    Height="40"
                    Visibility="Collapsed"
                    Style="{StaticResource ActionButtonStyle}"
                    x:Name="AddButton"
                    Click="AddButton_Click"/>

            <Button Content="Сохранить"
                    Width="110"
                    Height="40"
                    Visibility="Collapsed"
                    Style="{StaticResource ActionButtonStyle}"
                    x:Name="SaveButton"
                    Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
